{% extends "_layouts/cp" %}
{% import "_includes/forms" as forms %}

{% set title = menu.name %}
{% set crumbs = [
    {
        label: 'Olive Menus'|t('olivemenus'),
        url: cpUrl('olivemenus/' ~ objSite.handle),
    },
] %}

{% set editorUrl = cpUrl('olivemenus/menu-items/' ~ menu.id) %}

{% block actionButton %}
    <div class="buttons">
        {% if hasMenuFieldLayout %}
            <a class="btn" href="{{ cpUrl('olivemenus/menu-fields/' ~ menu.id) }}">{{ 'Menu content'|t('olivemenus') }}</a>
        {% endif %}
        <a class="btn" href="{{ cpUrl('olivemenus/menu-history/' ~ menu.id) }}">{{ 'Revision history'|t('olivemenus') }}</a>
        {% if isDraft %}
            <a class="btn" href="{{ cpUrl('olivemenus/menu-preview/' ~ menu.id) }}">{{ 'Preview saved draft'|t('olivemenus') }}</a>
        {% endif %}
        <button type="submit" class="btn submit" form="menu-items-form">{{ (isDraft ? 'Save draft' : 'Save menu')|t('olivemenus') }}</button>
    </div>
{% endblock %}

{% set content %}
    <div class="pane">
        {% if isDraft %}
            <p><strong>{{ 'Draft'|t('olivemenus') }}</strong> {{ 'Changes appear on the website when you publish the saved draft.'|t('olivemenus') }}</p>
            {% if draft.isStale %}
                <p class="warning">{{ 'The live menu changed after this draft was created. Compare the draft with the live menu before starting a new draft.'|t('olivemenus') }}</p>
            {% endif %}
            <div class="buttons">
                <a class="btn" href="{{ editorUrl }}">{{ 'View live menu'|t('olivemenus') }}</a>
                {% if not draft.isStale %}
                    <form method="post" action="{{ editorUrl }}" aria-label="{{ 'Publish saved draft'|t('olivemenus') }}">
                        {{ csrfInput() }}
                        {{ actionInput('olivemenus/menu-revisions/publish') }}
                        {{ hiddenInput('menuId', menu.id) }}
                        {{ hiddenInput('draftVersion', draft.version) }}
                        <button type="submit" class="btn">{{ 'Publish saved draft'|t('olivemenus') }}</button>
                    </form>
                {% endif %}
                <form method="post" action="{{ editorUrl }}" aria-label="{{ 'Discard draft'|t('olivemenus') }}">
                    {{ csrfInput() }}
                    {{ actionInput('olivemenus/menu-revisions/discard') }}
                    {{ hiddenInput('menuId', menu.id) }}
                    {{ hiddenInput('draftVersion', draft.version) }}
                    <button type="submit" class="btn">{{ 'Discard draft'|t('olivemenus') }}</button>
                </form>
            </div>
        {% else %}
            <p><strong>{{ 'Live menu'|t('olivemenus') }}</strong> {{ 'Saving here updates the website immediately.'|t('olivemenus') }}</p>
            {% if draft %}
                <a class="btn" href="{{ cpUrl('olivemenus/menu-items/' ~ menu.id, {draft: 1}) }}">{{ 'Open draft'|t('olivemenus') }}</a>
            {% else %}
                <form method="post" action="{{ editorUrl }}" aria-label="{{ 'Create draft'|t('olivemenus') }}">
                    {{ csrfInput() }}
                    {{ actionInput('olivemenus/menu-revisions/start') }}
                    {{ hiddenInput('menuId', menu.id) }}
                    <button type="submit" class="btn">{{ 'Create draft'|t('olivemenus') }}</button>
                </form>
            {% endif %}
        {% endif %}
    </div>
    <div class="olive-menu-editor">
        <aside id="menu-items-sidebar" aria-labelledby="add-menu-items">
            <h2 id="add-menu-items">{{ 'Add menu items'|t('olivemenus') }}</h2>
            <div class="buttons">
                {% for elementType, label in elementTypes %}
                    <button type="button" class="btn add icon" data-menu-element-type="{{ elementType }}" data-site-id="{{ menu.site_id }}">
                        {{ label }}
                    </button>
                {% endfor %}
            </div>

            <h3>{{ 'Custom items'|t('olivemenus') }}</h3>
            <form class="custom-url" method="post">
                <div class="fields-custom">
                    {% set kindOptions = {
                        link: 'Custom link'|t('olivemenus'),
                        heading: 'Heading'|t('olivemenus'),
                        group: 'Group'|t('olivemenus'),
                    } %}
                    {% if siteLinkOptions %}
                        {% set kindOptions = kindOptions|merge({site: 'Site link'|t('olivemenus')}) %}
                    {% endif %}
                    {{ forms.selectField({
                        label: 'Item type'|t('olivemenus'),
                        id: 'custom-menu-kind',
                        options: kindOptions,
                        value: 'link',
                    }) }}
                    {{ forms.textField({
                        label: 'Item text'|t('olivemenus'),
                        id: 'custom-menu-title',
                        maxlength: 255,
                        required: true,
                    }) }}
                    <div id="custom-menu-url-field">
                        {{ forms.textField({
                            label: 'URL'|t('olivemenus'),
                            id: 'custom-menu-url',
                            placeholder: '/contact',
                            maxlength: 255,
                        }) }}
                    </div>
                    {% if siteLinkOptions %}
                        <div id="custom-menu-site-field" hidden>
                            {{ forms.selectField({
                                label: 'Destination site'|t('olivemenus'),
                                id: 'custom-menu-site',
                                options: {'': 'Choose a site'|t('olivemenus')}|merge(siteLinkOptions),
                            }) }}
                        </div>
                    {% endif %}
                </div>
                <button type="submit" class="btn">{{ 'Add to menu'|t('olivemenus') }}</button>
            </form>
        </aside>

        <section id="menu-items" aria-labelledby="menu-structure">
            <h2 id="menu-structure">{{ 'Menu structure'|t('olivemenus') }}</h2>
            <template id="group-source-template">
                {% include "olivemenus/_group-source" with {
                    settingsId: 'group-source-template',
                    sourceUid: '',
                    sourceSort: 'newest',
                    sourceLimit: 10,
                } %}
            </template>
            <template id="item-presentation-template">
                {% include 'olivemenus/_item-presentation' with {settingsId: 'item-presentation-template', isGroup: true} only %}
            </template>
            <p class="light">{{ 'Drag items to arrange them, or use the move controls in each item’s settings.'|t('olivemenus') }}</p>
            <form method="post" action="{{ editorUrl }}" accept-charset="UTF-8" id="menu-items-form" aria-labelledby="menu-structure">
                {{ csrfInput() }}
                {% if isDraft %}
                    {{ actionInput('olivemenus/menu-items/store-draft') }}
                    {{ hiddenInput('draft-version', draft.version) }}
                {% else %}
                    {{ actionInput('olivemenus/menu-items/save-menu-items') }}
                    {{ hiddenInput('live-version', liveVersion) }}
                {% endif %}
                <input type="hidden" name="menu-id" value="{{ menu.id }}" />
                <input type="hidden" id="menu-items-deleted" name="menu-items-deleted" value="" />
                <input type="hidden" id="menu-items-serialized" name="menu-items-serialized" value="" />
                <ol id="menu-list" class="sortable">
                    {{ menuItemsMarkup|raw }}
                </ol>
                <p id="menu-list-placeholder" {% if menuItemsMarkup is not empty %}style="display: none;"{% endif %}>
                    {{ 'Add an item to start building this menu.'|t('olivemenus') }}
                </p>
            </form>
            {% if devMode %}
                <div class="olive-menu-twig">
                    <h3>{{ 'Twig template'|t('olivemenus') }}</h3>
                    <code>{{ "{{ craft.olivemenus.getMenuHTML('" ~ menu.handle ~ "') }}" }}</code>
                    <p><a href="https://github.com/OliveStudio/olivemenus/wiki/06.-Insert-Twig-snippet">{{ 'View Twig examples'|t('olivemenus') }}</a></p>
                </div>
            {% endif %}
        </section>
    </div>
{% endset %}
