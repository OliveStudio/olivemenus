{% extends "_layouts/cp" %}

{# Link for the ? icon at the bottom of the page #}
{% set docsUrl = "https://github.com/OliveStudio/olivemenus/wiki" %}

{# The title of this CP section #}
{% set title = "Menus" %}

{% set selectedTab = 'menus' %}

{% set showSiteMenu = (craft.app.getIsMultiSite() ? true : false) %}
{% set urlFormat = 'olivemenus/{handle}' %}
{% set selectedSiteId = objSite.id %}

{% block contextMenu %}
    {% if showSiteMenu %}
        {% include "_elements/sitemenu" %}
    {% endif %}
{% endblock %}

{% block actionButton %}
    <a href="{{ url('olivemenus/menu-new/' ~ objSite.handle) }}" class="btn submit add icon">{{ "New menu"|t('olivemenus') }}</a>
{% endblock %}

{# The content of the CP Section#}
{% set content %}
    <p id="menu-none" {% if menus is not empty %} class="hidden" {% endif %}>{{ "No menus exist yet."|t('olivemenus') }}</p>
    {% if menus | length %}
    <table id="menu-list" class="data fullwidth collapsible">
        <thead>
            <tr>
            <th scope="col">{{ "Name"|t('olivemenus') }}</th>
            <th scope="col">{{ "Handle"|t('olivemenus') }}</th>
            <th class="thin" scope="col"></th>
            </tr>
        </thead>
        <tbody>
        {% for menu in menus %}
            <tr data-id="{{ menu.id }}" data-name="{{ menu.name|t('olivemenus') }}">
                <th scope="row" data-title="{{ 'Name'|t('olivemenus') }}"><a href="{{ url('olivemenus/menu-items/' ~ menu.id) }}">{{ menu.name|t('olivemenus') }}</a></th>
                <td data-title="{{ 'Handle'|t('olivemenus') }}"><code>{{ menu.handle }}</code></td>
                <td class="thin">
                    {% set duplicateFormId = 'duplicate-menu-form-' ~ menu.id %}
                    <div class="flex flex-nowrap gap-xs">
                        <a class="btn small" href="{{ cpUrl('olivemenus/menu-edit/' ~ menu.id) }}">{{ 'Edit'|t('olivemenus') }}</a>
                        <form id="{{ duplicateFormId }}" method="post" action="{{ cpUrl('olivemenus/' ~ objSite.handle) }}" aria-labelledby="duplicate-menu-{{ menu.id }}">
                            {{ csrfInput() }}
                            {{ actionInput('olivemenus/menu/duplicate-menu') }}
                            {{ hiddenInput('menuId', menu.id) }}
                            <button type="submit" id="duplicate-menu-{{ menu.id }}" class="btn small" aria-label="{{ 'Duplicate {name}'|t('olivemenus', {name: menu.name}) }}">{{ 'Duplicate'|t('olivemenus') }}</button>
                        </form>
                        {% if duplicateSites is not empty %}
                            {{ disclosureMenu([{
                                heading: 'Linked content must exist on the destination site.'|t('olivemenus'),
                                items: duplicateSites|map(site => {
                                    label: site.name,
                                    attributes: {
                                        type: 'submit',
                                        form: duplicateFormId,
                                        name: 'targetSiteId',
                                        value: site.id,
                                    },
                                }),
                            }], {
                                buttonLabel: 'Copy to site'|t('olivemenus'),
                                hiddenLabel: 'Copy to site for {name}'|t('olivemenus', {name: menu.name}),
                                buttonAttributes: {class: ['small']},
                            }) }}
                        {% endif %}
                        <button type="button" class="btn small delete" aria-label="{{ 'Delete {name}'|t('olivemenus', {name: menu.name}) }}">{{ 'Delete'|t('olivemenus') }}</button>
                    </div>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    {% endif %}
{% endset %}
